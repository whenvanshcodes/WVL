<?xml version="1.0" encoding="utf-8"?>
<!-- WVL Expanded Music Widget (~4x2 / 4x3): Large artwork, track details, waveform motif, progress, full controls -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_expanded_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Row: Cover, Info and Monogram Branding -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Album Cover -->
        <ImageView
            android:id="@+id/widget_expanded_cover"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_default_cover" />

        <!-- Title, Artist and Album -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_expanded_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:text="@string/app_name"
                android:textColor="#F8FAFC"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_expanded_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:text="Tap to play music"
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <!-- Waveform motif + status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_expanded_waveform"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_wvl_waveform" />

                <TextView
                    android:id="@+id/widget_expanded_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="WVL Audio"
                    android:textColor="#60A5FA"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- WVL VB Monogram Badge -->
        <ImageView
            android:id="@+id/widget_expanded_logo"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="top"
            android:contentDescription="@null"
            android:src="@drawable/ic_wvl_logo" />
    </LinearLayout>

    <!-- Bottom Row: Transport Controls Centered -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_expanded_prev"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/widget_previous"
            android:scaleType="fitCenter"
            android:src="@drawable/msp_ic_previous" />

        <ImageButton
            android:id="@+id/widget_expanded_play"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/widget_play_pause"
            android:scaleType="fitCenter"
            android:src="@drawable/msp_ic_play" />

        <ImageButton
            android:id="@+id/widget_expanded_next"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/widget_next"
            android:scaleType="fitCenter"
            android:src="@drawable/msp_ic_next" />
    </LinearLayout>

</LinearLayout>
