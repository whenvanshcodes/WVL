<?xml version="1.0" encoding="utf-8"?>
<!-- WVL Compact Music Widget (~2x1): VB waveform logo, track & artist, prev, play/pause, next -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_compact_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="6dp">

    <!-- WVL VB Logo Monogram Badge -->
    <ImageView
        android:id="@+id/widget_compact_logo"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_wvl_logo" />

    <!-- Track & Artist Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_compact_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_compact_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="Tap to play"
            android:textColor="#94A3B8"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Playback Controls -->
    <ImageButton
        android:id="@+id/widget_compact_prev"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/notif_action_previous"
        android:scaleType="fitCenter"
        android:src="@drawable/msp_ic_previous" />

    <ImageButton
        android:id="@+id/widget_compact_play"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/notif_action_play"
        android:scaleType="fitCenter"
        android:src="@drawable/msp_ic_play" />

    <ImageButton
        android:id="@+id/widget_compact_next"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/notif_action_next"
        android:scaleType="fitCenter"
        android:src="@drawable/msp_ic_next" />

</LinearLayout>
