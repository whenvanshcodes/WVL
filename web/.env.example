# WhenVanshListens Web Environment Variables
# Copy this file to .env.local to configure for local development or Vercel

# Spotify Client ID for Browser PKCE OAuth (No client secret required in browser)
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=your_spotify_client_id_here

# Optional: Production deployment URL for OAuth redirect uri fallback
NEXT_PUBLIC_APP_URL=https://whenvanshlistens.vercel.app
